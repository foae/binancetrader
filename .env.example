# HTTP Server Configuration
HTTP_LISTEN_ADDRESS=127.0.0.1:8123
ENV_MODE=dev
SERVICE_NAME=binancetrader

# Logging Configuration
# Logs are written to both stdout and this file
LOG_FILE=./logs/binancetrader.log

# DragonFly/Redis Configuration
# Format: redis://[user:password@]host:port/db
REDIS_URL=redis://localhost:6379/0

# Binance API Configuration
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
# live = production (api.binance.com)
# demo = paper trading (demo-api.binance.com, keys from demo.binance.com)
# testnet = testnet (testnet.binance.vision)
BINANCE_MODE=demo

# Trading Configuration
# Comma-separated trading pairs (format: BASE/QUOTE)
ENABLED_PAIRS=BTC/USDC,ETH/USDC
DRY_RUN=true

# Strategy Configuration
# BUY_OFFSET: how far below market price to place limit buy (decimal, 0.001 = 0.1%)
BUY_OFFSET=0.001
# BUY_QUANTITY_USDC: USDC amount per buy order
BUY_QUANTITY_USDC=5
# TAKE_PROFIT: sell target above entry price (decimal, 0.01 = 1%)
TAKE_PROFIT=0.01
# ORDER_EXPIRY: cancel open GTC orders older than this (Go duration, e.g. 1h, 30m)
ORDER_EXPIRY=1h
